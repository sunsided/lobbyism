# Copy to .env and fill in. Real environment variables override this file.
# Secrets: generate with `openssl rand -hex 32`, share with the game server
# (netcode key) and your auth backend (HMAC secret), never with clients.
LOBBYISM_BIND=127.0.0.1:7878
LOBBYISM_HMAC_SECRET=
LOBBYISM_NETCODE_KEY=
LOBBYISM_PROTOCOL_ID=7
LOBBYISM_GAME_SERVERS=127.0.0.1:5000
LOBBYISM_MODES=duel=2
LOBBYISM_REGIONS=eu,us
